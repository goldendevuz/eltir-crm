# ============================================================ Telegram bot
# @BotFather dan olinadi. PROVIDER_TOKEN to'lov uchun (Click test tokeni ham
# bo'ladi) — to'lovsiz ishlatmoqchi bo'lsangiz bo'sh qoldiring.
BOT_TOKEN=111956:AAEMce-_xs8
PROVIDER_TOKEN=41067:4ec97cd91499
# Bot administratorlarining Telegram ID'lari, vergul bilan.
ADMINS=123456

# ============================================================ Do'kon brendi
# Biz Azizon'ning Qo'qondagi dileri­miz — rasmiy Azizon (Samarqand) emas.
# Bu qiymatlar bot matnlarida va admin panel sarlavhasida ishlatiladi.
SHOP_NAME=Azizon Qo'qon
SHOP_TAGLINE=Rasmiy diler · Qo'qon shahri
SHOP_PHONE=+998 90 000 00 00

# ============================================================ Infratuzilma
# docker-compose ishlatilsa — servis nomlari; aks holda "localhost".
ip=db
redis_host=redis
POSTGRES_USER=tgbot
POSTGRES_PASSWORD=tgbot
POSTGRES_DB=tgshop

# ============================================================ Django
# DEV uchun quyidagicha qoldiring.
DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
SECURE_SSL=0

# ============================================ Cloudflare tunnel (faqat prod)
# Panelni panel.univel.uz da ochish uchun. Token Cloudflare Zero Trust
# panelida yaratiladi: Networks -> Tunnels -> Create tunnel -> Docker.
# Public hostname: panel.univel.uz  ->  http://web:8000
# Bo'sh qoldirilsa tunnel ishga tushmaydi (u "tunnel" profilida).
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- PROD uchun
# Deploy oldidan quyidagilarni almashtiring:
#   DEBUG=0
#   SECRET_KEY=<64 belgili tasodifiy satr>
#       python -c "import secrets;print(secrets.token_urlsafe(48))"
#   ALLOWED_HOSTS=panel.univel.uz
#   CSRF_TRUSTED_ORIGINS=https://panel.univel.uz
#   SECURE_SSL=1   ← faqat sayt HTTPS orqasida bo'lsa. TLS'siz yoqilsa
#                    redirect-loop bo'lib, sessiya cookie'si yo'qoladi.
